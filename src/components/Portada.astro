---
// Portada.astro
---

<section
    id="portada-sobre"
    class="fixed inset-0 w-full h-screen z-[10000] overflow-hidden flex items-center justify-center"
    style="background-color: #FFCDD4; height: 100dvh;"
>
    <!-- La portada se diseña a 430x932 (proporción de celular) y se escala
         entera para caber en la pantalla. Así se ve idéntica en celular,
         tablet y computadora: solo cambia el tamaño, no las proporciones. -->
    <div id="portada-escala" class="w-full h-full flex justify-center">
    <div id="portada-col" class="relative w-full max-w-[430px] h-full">
    <!-- SOBRE - fondo que ocupa todo el ancho de la pantalla -->
    <img
        id="sobre-img"
        src="/imagenes/portada.webp"
        alt="Sobre de invitación"
        class="portada-fondo absolute top-0 left-0 w-full h-full"
    />

    <!-- TÍTULO SUPERIOR -->
    <div
        id="titulo-portada"
        class="absolute top-[9%] left-0 right-0 text-center z-20 px-6"
    >
        <p
            class="font-cormorant uppercase tracking-[0.3em] text-xl font-semibold drop-shadow-[0_1px_3px_rgba(255,255,255,0.6)]"
            style="color: #BE5266;"
        >
            ¡Nos Casamos!
        </p>
    </div>

    <!-- SELLO / BOTÓN - centrado sobre la imagen -->
    <div class="absolute inset-0 flex items-center justify-center z-20">
        <button
            id="btn-sello"
            class="cursor-pointer transition-all duration-300 hover:scale-110 active:scale-95 focus:outline-none"
        >
            <img
                src="/imagenes/boton.png"
                alt="Sello"
                class="w-28 h-28 md:w-32 md:h-32"
                style="filter: drop-shadow(0 5px 16px rgba(190, 82, 102, 0.35));"
            />
        </button>
    </div>

    <!-- TEXTO - posicionado sobre la portada -->
    <div
        id="texto-portada"
        class="absolute top-[calc(50%+4.5rem)] left-0 right-0 text-center z-20 px-6 flex flex-col items-center"
    >
        <p
            class="font-cormorant uppercase tracking-[0.32em] text-sm md:text-base font-semibold"
            style="color: #BE5266;"
        >
            DALE CLIC AL SELLO
        </p>
        <p
            class="font-cormorant uppercase tracking-normal text-sm md:text-base font-medium mt-0.5"
            style="color: #B34155;"
        >
            PARA INGRESAR A LA INVITACIÓN
        </p>
        <p
            class="font-crimson italic text-xl md:text-2xl mt-4"
            style="color: #B34155;"
        >
            Atentamente:
        </p>
        <h2
            class="font-great-vibes text-[2rem] sm:text-4xl md:text-5xl mt-3 leading-[1.3]"
            style="color: #BE5266;"
        >
            Oscar Leopoldo<br/>
            <span class="font-cormorant text-xl" style="color: #A88C61;">&</span><br/>
            Ynés Esther
        </h2>
    </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";

    // ═══ AL RECARGAR SIEMPRE SE EMPIEZA DESDE ARRIBA ═══
    // Evita que el navegador restaure la posición del scroll y que, al abrir
    // el sobre, el invitado caiga a la mitad de la invitación.
    if ("scrollRestoration" in history) {
        history.scrollRestoration = "manual";
    }
    window.scrollTo(0, 0);
    window.addEventListener("load", () => window.scrollTo(0, 0));

    // ═══ ESCALA DE LA PORTADA ═══
    // Se elige el menor factor entre ancho y alto para que el diseño
    // de 430x932 entre completo, sin recortes ni barras de scroll.
    const ANCHO_DISENO = 430;
    const ALTO_DISENO = 932;
    function ajustarEscala() {
        const caja = document.getElementById("portada-escala");
        const col = document.getElementById("portada-col");
        if (!caja || !col) return;

        // En celular NO se escala nada: la portada ocupa toda la pantalla,
        // exactamente como estaba antes.
        if (window.innerWidth < 640) {
            caja.style.transform = "none";
            caja.style.width = "100%";
            caja.style.height = "100%";
            col.style.width = "";
            col.style.height = "";
            return;
        }

        // De tablet en adelante sí: el diseño de 430x932 se escala para
        // caber entero, así se ve con las proporciones del celular.
        col.style.width = ANCHO_DISENO + "px";
        col.style.height = ALTO_DISENO + "px";
        caja.style.width = "auto";
        caja.style.height = "auto";
        const factor = Math.min(
            window.innerWidth / ANCHO_DISENO,
            window.innerHeight / ALTO_DISENO,
        );
        caja.style.transform = "scale(" + factor + ")";
    }
    ajustarEscala();
    window.addEventListener("resize", ajustarEscala);

    document.addEventListener("DOMContentLoaded", () => {
        ajustarEscala();
        const btnSello = document.getElementById("btn-sello");
        const portada = document.getElementById("portada-sobre");

        gsap.from("#btn-sello", {
            scale: 0.8,
            duration: 1.5,
            ease: "elastic.out(1, 0.5)",
            delay: 0.5,
        });

        gsap.to("#btn-sello", {
            scale: 1.05,
            duration: 2.5,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
        });

        gsap.from("#titulo-portada", {
            opacity: 0,
            y: -18,
            duration: 1.2,
            ease: "power2.out",
            delay: 0.3,
        });

        gsap.from("#texto-portada", {
            opacity: 0,
            y: 18,
            duration: 1.2,
            ease: "power2.out",
            delay: 0.4,
        });

        btnSello?.addEventListener("click", () => {
            // Siempre entra por el inicio (NombresFlores), sin importar
            // dónde estaba el scroll antes de recargar.
            window.scrollTo(0, 0);

            const audio = new Audio("/musica/melodia.mp3");
            audio.loop = true;
            audio.volume = 0.5;
            audio.play().catch((error: any) => {
                console.log("Error al reproducir audio:", error);
            });

            (window as any).audioGlobal = audio;
            (window as any).estaReproduciendoGlobal = true;

            // El botón flotante de música recién aparece al abrir el sobre
            const wrapperMusica = document.getElementById("wrapper-musica");
            wrapperMusica?.classList.remove("hidden");
            wrapperMusica?.classList.add("flex");

            setTimeout(() => {
                const iconoPlay = document.getElementById("icono-play-global");
                const iconoPause = document.getElementById("icono-pause-global");
                if (iconoPlay && iconoPause) {
                    iconoPlay.classList.add("hidden");
                    iconoPause.classList.remove("hidden");
                }
            }, 100);

            gsap.to(portada, {
                opacity: 0,
                duration: 0.8,
                ease: "power2.out",
                onStart: () => {
                    document.documentElement.style.overflow = "auto";
                    document.body.style.overflow = "auto";
                },
                onComplete: () => {
                    portada?.remove();
                },
            });
        });
    });
</script>

<style>
    #portada-escala {
        transform-origin: center center;
        flex: none;
    }

    /* Mientras la portada está visible no se puede desplazar la página.
       Hace falta en html Y en body: solo con body el navegador sigue
       permitiendo el scroll. Se libera al abrir el sobre. */
    html,
    body {
        overflow: hidden;
    }

    /* ── Imagen de fondo de la portada ──────────────────────────
       En celular (columna vertical) la imagen se ESTIRA para cubrir
       todo el alto, así los celulares largos no dejan franjas.     */
    .portada-fondo {
        object-fit: fill;
        object-position: center;
    }

    /* En pantallas anchas se recorta en vez de deformarse. */
    @media (min-width: 640px) {
        .portada-fondo {
            object-fit: cover;
            object-position: top center;
        }
    }
</style>
